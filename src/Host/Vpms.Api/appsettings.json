{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "RateLimiting": {
    "PermitLimit": 600,
    "AuthPermitLimit": 30,
    "WindowSeconds": 60
  },
  "Auth": {
    "IdleTimeout": "00:30:00",
    "AbsoluteTimeout": "08:00:00",
    "AllowInsecureMetadata": false
  }
}
